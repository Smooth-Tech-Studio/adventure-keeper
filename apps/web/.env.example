# Firebase Web App configuration for a REAL project.
#
# Local development uses the Firebase emulators by default (see
# `apps/web/.env.development` + `pnpm dev`) and needs none of this.
#
# To develop against a real project instead: copy this file to `.env.local`
# (git-ignored, wins key-by-key over `.env.development`), fill in the values
# from the Firebase console — Project settings -> General -> Your apps ->
# SDK setup and configuration -> Config — and set VITE_FIREBASE_USE_EMULATORS
# to false. Then run `pnpm dev:app`. See docs/DEPLOYMENT.md.

VITE_FIREBASE_USE_EMULATORS=false

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional — importing images into the player's Dropbox (docs/IMAGE_STORAGE.md).
# The "App key" of a Dropbox app (Scoped access, App folder). Empty = no import.
VITE_DROPBOX_APP_KEY=
