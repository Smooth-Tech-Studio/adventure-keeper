# Loaded automatically by Vite in dev mode (`vite` / `pnpm dev`).
# Points the front at the local Firebase emulators — no real project needed.
# `pnpm dev` starts the Auth + Firestore emulators alongside the front;
# `pnpm emulators:seed` fills them with test data.
#
# To develop against a real Firebase project instead, put your values in
# `apps/web/.env.local` (git-ignored) — it overrides this file — and unset
# VITE_FIREBASE_USE_EMULATORS there.

VITE_FIREBASE_USE_EMULATORS=true

# Dummy config: the emulators ignore these, they only need to be non-empty.
VITE_FIREBASE_API_KEY=demo-api-key
VITE_FIREBASE_AUTH_DOMAIN=adv-keeper.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=adv-keeper
VITE_FIREBASE_STORAGE_BUCKET=adv-keeper.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=000000000000
VITE_FIREBASE_APP_ID=1:000000000000:web:0000000000000000000000
