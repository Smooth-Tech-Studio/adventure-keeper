{
  "name": "adventure-keeper",
  "version": "0.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "description": "Monorepo for Adventure Keeper — a collaborative web platform for tabletop role-playing games.",
  "packageManager": "pnpm@11.17.0",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev": "concurrently -k -n emulators,app -c blue.bold,green.bold \"pnpm run emulators\" \"turbo run dev\"",
    "dev:https": "DEV_HTTPS=1 pnpm run dev",
    "dev:expose": "concurrently -k -n emulators,app -c blue.bold,green.bold \"pnpm run emulators:expose\" \"DEV_EXPOSE=1 turbo run dev\"",
    "dev:app": "turbo run dev",
    "emulators": "firebase emulators:start --only auth,firestore",
    "emulators:expose": "firebase emulators:start --only auth,firestore --config firebase.expose.json",
    "emulators:seed": "pnpm run build:locale && tsx scripts/seed.ts",
    "build": "turbo run build",
    "build:locale": "pnpm --filter @adventure-keeper/locale build",
    "typecheck": "turbo run typecheck",
    "clean": "turbo run clean && rimraf node_modules",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,css}\"",
    "web:dev": "pnpm --filter @adventure-keeper/web dev",
    "web:build": "pnpm --filter @adventure-keeper/web build",
    "firebase:emulators": "pnpm run emulators",
    "firebase:deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm run build:locale && playwright test",
    "test:e2e:ui": "pnpm run build:locale && playwright test --ui",
    "catalogs:export": "pnpm run build:locale && tsx scripts/export-catalogs.ts"
  },
  "devDependencies": {
    "@adventure-keeper/schemas": "workspace:*",
    "@adventure-keeper/system-dnd2024": "workspace:*",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "firebase-admin": "^14.5.0",
    "firebase-tools": "15.34.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "tsx": "^4.23.15",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.0",
    "vitest": "^5.0.5"
  }
}
