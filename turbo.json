{
  "$schema": "https://turbo.build/schema.json",
  "ui": "stream",
  "globalEnv": ["VITE_*", "DEV_HTTPS", "DEV_EXPOSE"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true
    },
    "clean": {
      "cache": false
    }
  }
}
