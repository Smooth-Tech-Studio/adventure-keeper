{
  "name": "@adventure-keeper/schemas",
  "version": "0.0.0",
  "license": "PolyForm-Noncommercial-1.0.0",
  "private": true,
  "description": "Shared Zod schemas and TypeScript types for Adventure Keeper's Firestore data model.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist"
  },
  "dependencies": {
    "@adventure-keeper/locale": "workspace:*",
    "@adventure-keeper/system-dnd2024": "workspace:*",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3"
  }
}
